# MISP repositories
[mariadb]
name=mariadb
baseurl=https://yum.mariadb.org/11.8/rhel10-amd64
enabled=1
module_hotfixes=1
gpgkey=https://yum.mariadb.org/RPM-GPG-KEY-MariaDB
gpgcheck=1

[misp]
name=misp
baseurl=https://repo.misp-project.ch/yum/misp10
enabled=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-KOJI-MISPPROJECT-EL10
gpgcheck=1
